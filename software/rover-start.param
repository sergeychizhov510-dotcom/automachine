# Стартовый набор параметров ArduPilot Rover для учебной машины 1:10.
# Загрузка: Mission Planner -> CONFIG -> Full Parameter List -> Load from file.
# Перед записью проверьте каждое значение: у параметра в Mission Planner
# есть подсказка с допустимыми значениями (у разных версий прошивки могут отличаться).
#
# ---- Тип машины и выходы
# 1 = наземная машина (Rover)
FRAME_CLASS,1
# выход 1 = руль (сервопривод), выход 3 = газ (регулятор хода)
SERVO1_FUNCTION,26
SERVO3_FUNCTION,70
#
# ---- Переключатель режимов на канале 8 пульта (3 положения)
# низ = MANUAL (ручной), середина = HOLD (стоп), верх = AUTO (маршрут)
MODE_CH,8
MODE1,0
MODE4,4
MODE6,10
#
# ---- Тумблеры пульта
# канал 5 = вкл/выкл моторов, канал 6 = аварийный стоп, канал 7 = ручной выбор навигации (GPS / колёса)
RC5_OPTION,153
RC6_OPTION,31
RC7_OPTION,90
#
# ---- Поведение при отказах
# потеря пульта: в режиме AUTO маршрут продолжается
FS_THR_ENABLE,2
FS_TIMEOUT,1.5
# в остальных режимах — стоп (HOLD), дальше бортовой диспетчер переводит в AUTO
FS_ACTION,2
# потеря телеметрии: в режиме AUTO маршрут продолжается
FS_GCS_ENABLE,2
# навигация недостоверна: стоп
FS_EKF_ACTION,1
# машина застряла или перевернулась: стоп
FS_CRASH_CHECK,1
#
# ---- Маршрут
CRUISE_SPEED,2
# продолжать маршрут с текущей точки, а не с начала
MIS_RESTART,0
#
# ---- Геозона: круг 100 м вокруг точки старта + многоугольник
FENCE_ENABLE,1
FENCE_TYPE,6
FENCE_RADIUS,100
#
# ---- Навигация EKF3: два набора источников
AHRS_EKF_TYPE,3
EK2_ENABLE,0
EK3_ENABLE,1
# набор 1: GPS (3) для положения и скорости, барометр (1) для высоты, компас (1) для курса
EK3_SRC1_POSXY,3
EK3_SRC1_VELXY,3
EK3_SRC1_POSZ,1
EK3_SRC1_VELZ,3
EK3_SRC1_YAW,1
# набор 2: без GPS — скорость по энкодеру колеса (7), курс по компасу
EK3_SRC2_POSXY,0
EK3_SRC2_VELXY,7
EK3_SRC2_POSZ,1
EK3_SRC2_VELZ,0
EK3_SRC2_YAW,1
#
# ---- Энкодер колеса (квадратурный)
WENC_TYPE,1
# WENC_CPR, WENC_RADIUS, WENC_PINA, WENC_PINB, WENC_POS_X/Y задайте по своей машине
# (см. документ проекта, раздел «Сборка», шаг про энкодер)
